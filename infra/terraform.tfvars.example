# DNS is not managed by Terraform: the parent zone lives in a different AWS
# account (see dns.tf). Apply prints a `dns_records_required` output listing
# every record to create by hand.
#
# Copy to terraform.tfvars (gitignored) and fill in real values. None of these
# are committed anywhere in the repo — see infra/backend.tf for how the state
# backend itself is configured without committing an account-specific name.

aws_account_id   = "123456789012"
aws_profile      = "your-sso-profile"
aws_region       = "ap-southeast-2"
support_domain   = "support.example.com" # mail: MX/SPF/DMARC/DKIM/MAIL FROM
web_domain       = "support.example.com" # web app + CloudFront — can differ from support_domain
github_repo      = "your-org/toolbox"
db_prefix        = "prod"
allowed_origins  = ["https://support.example.com"]
alert_email      = "alerts@example.com"

inbound_retention_days = 30

# Optional — leave blank (or omit) to skip Turnstile verification entirely.
turnstile_secret_key = ""

# Optional — signs the OAuth client ids MCP clients register with. Leave blank
# and MCP clients can't register. Generate with: openssl rand -base64 48
oauth_client_id_secret = ""
