# Non-secret local defaults, committed. Secrets go in `.env.secret` (see
# `.env.secret.example`), which is gitignored.

DB_PREFIX=prod
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_ORIGIN=http://localhost:5173

# Skip Cloudflare Turnstile verification locally — a fork works with no
# Cloudflare account. See CLAUDE.md / the auth step for how this is consumed.
TURNSTILE_DISABLED=1
