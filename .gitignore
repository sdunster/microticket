.DS_Store
.env.secret
CLAUDE.local.md

# Terraform — .terraform.lock.hcl is committed (unlike some projects that
# gitignore it): it pins provider versions so `terraform init` is
# reproducible. Only the working state/cache and secret values are ignored.
infra/terraform.tfvars
infra/.terraform/

# DynamoDB Local + local mail fixtures
local/.dynamodb-data/
local/.dynamodb.pid
local/.dynamodb.log
local/dynamodb-local/
local/.e2e/
local/mail-out/

node_modules/

# Relay codegen output — regenerated by `npm run relay` as a pre-build/pre-test
# step (see web/package.json), so committing it would just be diff noise.
web/src/**/__generated__/

# Throwaway TF_DATA_DIR used by `make check` so validating does not disturb
# a real `terraform init` against the S3 backend.
infra/.terraform-check/
