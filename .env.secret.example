# Copy this file to `.env.secret` and fill in real values. `.env.secret` is
# gitignored — never commit it.

# Signing secret for `mtu_` auth tokens. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# Cloudflare Turnstile secret key. Optional — verification is skipped whenever
# this is unset (or when TURNSTILE_DISABLED=1 in `.env`), so a fork works with
# no Cloudflare account. Only needed if you want to exercise the CAPTCHA path
# locally.
TURNSTILE_SECRET_KEY=
